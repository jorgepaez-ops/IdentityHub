// Grafana Alloy: recoge los logs de todos los contenedores y los envía a Loki.
// Sustituye a Promtail, que está descontinuado.

discovery.docker "contenedores" {
  host = "unix:///var/run/docker.sock"
}

// Solo interesan los contenedores de este proyecto, y se etiquetan por servicio
// para poder filtrar en Grafana por `service="api"`.
discovery.relabel "identity" {
  targets = discovery.docker.contenedores.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "identity-hub"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "identity" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.identity.output
  forward_to = [loki.process.json.receiver]
}

// La API y el worker emiten JSON estructurado: extraer los campos permite
// consultar por nivel o por trace_id sin analizar texto libre.
loki.process "json" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      level    = "level",
      msg      = "msg",
      trace_id = "trace_id",
    }
  }

  stage.labels {
    values = { level = "" }
  }

  // Alertas de Falco (JSON, una por línea): `rule` y `priority` como etiquetas permiten consultar y
  // alertar por regla o gravedad. Las líneas de arranque de Falco no son JSON y no pasan el selector.
  stage.match {
    selector = "{service=\"falco\"} |= \"\\\"rule\\\"\""

    stage.json {
      expressions = {
        rule     = "rule",
        priority = "priority",
      }
    }

    stage.labels {
      values = { rule = "", priority = "" }
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
