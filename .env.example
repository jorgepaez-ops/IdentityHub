# ─────────────────────────────────────────────────────────────
# Copiar a .env y rellenar. NUNCA commitear .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL ---
POSTGRES_USER=identity
POSTGRES_PASSWORD=          # obligatorio, sin valor por defecto
POSTGRES_DB=identity
DATABASE_URL=postgres://identity:${POSTGRES_PASSWORD}@db:5432/identity?sslmode=disable

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=identity
RABBITMQ_DEFAULT_PASS=      # obligatorio
RABBITMQ_URL=amqp://identity:${RABBITMQ_DEFAULT_PASS}@broker:5672/

# --- API ---
API_PORT=8081
API_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# Semilla Ed25519 de 32 bytes en base64 para firmar los JWT.
# Generar con: openssl rand -base64 32
JWT_SIGNING_KEY=
JWT_ISSUER=http://localhost:8080
TRUSTED_PROXIES=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- SMTP (Mailpit en local) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@identity.local

# --- Observabilidad ---
GRAFANA_ADMIN_PASSWORD=
