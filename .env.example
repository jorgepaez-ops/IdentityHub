# ─────────────────────────────────────────────────────────────
# Copiar a .env y rellenar. NUNCA commitear .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL ---
POSTGRES_USER=identity
POSTGRES_PASSWORD=          # obligatorio, sin valor por defecto (superusuario del contenedor)
POSTGRES_DB=identity

# Contraseña del rol de aplicación de mínimo privilegio (creado en T9;
# login/contraseña se asignan en deploy/postgres-init/ en el primer arranque).
IDENTITY_APP_PASSWORD=      # obligatorio; generar con: openssl rand -base64 32

# Usada por el servicio migrate (necesita DDL, por eso usa el superusuario).
MIGRATE_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable

# Usada por api y worker: conectan como identity_app, no como superusuario.
DATABASE_URL=postgres://identity_app:${IDENTITY_APP_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=identity
RABBITMQ_DEFAULT_PASS=      # obligatorio
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@broker:5672/

# --- API ---
API_PORT=8081
API_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# Semilla Ed25519 de 32 bytes en base64 para firmar los JWT.
# Generar con: openssl rand -base64 32
JWT_SIGNING_KEY=
JWT_ISSUER=http://localhost:8080
TRUSTED_PROXIES=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- SMTP (Mailpit en local) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@identity.local

# --- Observabilidad (solo con make up-obs) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
